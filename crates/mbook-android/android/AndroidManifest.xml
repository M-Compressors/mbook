<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of the mbook APK. `android.sh` replaces @VERSION_NAME@ and
  @VERSION_CODE@ with the version of the workspace.

  The activity is MbookActivity (`java/`), the GpuiInputActivity of
  gpui-mobile: a NativeActivity that loads libmbook_android.so
  (`android.app.lib_name`) and gives the keyboard of the system an input
  connection. OpenActivity receives the documents other apps hand over. The other three are
  transparent helpers of gpui-mobile for the document picker and for
  permission requests.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.m_compressors.mbook"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <!-- API 26 is where Vulkan becomes part of the platform. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- The renderer falls back to OpenGL ES 3 without Vulkan. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
        android:required="false" android:version="0" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="mbook"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/MbookTheme">

        <!--
          configChanges keeps the activity across rotation, resizing, the
          keyboard and dark mode: gpui-mobile adapts its window in place, and
          a recreated NativeActivity would start a second event loop.
        -->
        <activity
            android:name="io.github.m_compressors.mbook.MbookActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="mbook_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          OpenActivity receives what other apps open or share with mbook,
          in whatever task they start it, and brings MbookActivity up with
          it. It has no window: Theme.NoDisplay, and it finishes at once.
        -->
        <activity
            android:name="io.github.m_compressors.mbook.OpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!--
              Opening a document with mbook, and sharing one or several with
              it. The types are those of the formats mbook converts; an mbook
              file has no registered type, so providers send it as
              application/octet-stream. Keep them in step with
              BOOK_FILE_EXTENSIONS: a test checks the main ones.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Lends the files mbook shares to the app chosen, read-only. -->
        <provider
            android:name="io.github.m_compressors.mbook.MbookFiles"
            android:authorities="io.github.m_compressors.mbook.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
